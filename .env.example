# Copy this file to .env for local development and fill in real values.
# NEVER commit .env — it is already in .gitignore.
# On Railway, set these as environment variables in the service's Variables
# tab instead of using a .env file at all.

# ============================================================================
# REQUIRED — the app fails fast at startup with a clear error if these are
# missing or left as placeholder values (see src/lib/env.ts).
# ============================================================================

# PostgreSQL connection string. On Railway, reference the Postgres plugin's
# own DATABASE_URL variable (Railway lets you do this via variable references
# like ${{Postgres.DATABASE_URL}} in the service's Variables tab) rather than
# copy-pasting it — that way it stays correct if the database ever moves.
DATABASE_URL="postgresql://svp_app:CHANGE_ME@localhost:5432/svp_erp?schema=public"

# Signs and encrypts session cookies. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 random characters — the placeholder value below will
# be rejected at startup on purpose.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# ============================================================================
# SERVER
# ============================================================================

# "development" locally, "production" on Railway/any real deployment.
# Controls: cookie Secure flag, verbose vs. redacted logging, error detail.
NODE_ENV="development"

# Railway sets PORT automatically — do not hardcode a port in production.
# This default (4000) is only used for local development.
PORT=4000
HOST="0.0.0.0"

# When true (the default, recommended for Railway), this backend also serves
# the frontend (Sri Velan Pasumai ERP.dc.html, support.js, assets/, services/)
# from ./public on the SAME origin as the API — no CORS, no cross-site
# cookies, one Railway service, one URL. Set to "false" only if you
# deliberately deploy the frontend as a separate service (then CORS_ORIGIN
# below becomes required).
SERVE_FRONTEND=true

# The public URL of this deployment. Used to build links (e.g. password
# reset emails). On Railway this is your service's generated domain, e.g.
# https://your-app.up.railway.app
APP_URL="http://localhost:4000"

# ============================================================================
# SESSION COOKIE TUNING (optional — sensible defaults shown)
# ============================================================================
SESSION_COOKIE_NAME="svp_sid"
SESSION_MAX_AGE_MS=28800000
SESSION_IDLE_TIMEOUT_MS=1800000

# ============================================================================
# CORS — only required if SERVE_FRONTEND=false (separate frontend deployment)
# ============================================================================
# Must be the EXACT origin of your separately-deployed frontend, no trailing
# slash, no wildcard. Leave unset when SERVE_FRONTEND=true (same-origin
# deployments don't need CORS at all).
CORS_ORIGIN="http://localhost:5173"

# ============================================================================
# LOGIN THROTTLING / ACCOUNT LOCKOUT
# ============================================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000

# ============================================================================
# PASSWORD RESET EMAIL
# ============================================================================
# Leave SMTP_* unset to use the safe development email adapter (captures
# "sent" emails in memory instead of delivering them — see
# src/services/emailService.ts). Fill these in for real password-reset
# emails to be delivered in production; a real SmtpEmailAdapter
# implementation (e.g. using nodemailer) must be wired in first.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sri Velan Pasumai ERP <no-reply@example.com>"

# ============================================================================
# BACKUP
# ============================================================================
# Where scripts/db-backup.sh writes timestamped .dump files.
BACKUP_DIRECTORY="./backups"
# How many recent backups to keep before older ones are deleted.
BACKUP_RETENTION_COUNT=14

# ============================================================================
# SEED (development/demo only — NEVER treat as production credentials)
# ============================================================================
# Controls the password set for all demo users created by `npm run seed`.
# The seed script is never run automatically — it's an explicit, manual step,
# and should never be run against a database that might contain real data.
DEV_SEED_PASSWORD="ChangeMe123!"
